      "name": "Real-time Feedback (v1)",
      "description": {
        "content": "V1 endpoint for real-time peer feedback between a single sender and recipient.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b6c15698-3d66-43ba-9990-b534383ffb03",
          "name": "List real-time feedback (v1)",
          "request": {
            "name": "List real-time feedback (v1)",
            "description": {
              "content": "Returns a paginated list of all public, positive real-time feedback records. By default 200 results are returned per query. When more than 200 results exist, the response includes pagination links for the next and last pages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "real-time-feedback"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created_before",
                  "value": "<long>",
                  "description": "A UNIX timestamp representing the oldest time a feedback was created. Defaults to the time the request was issued."
                },
                {
                  "disabled": false,
                  "key": "created_after",
                  "value": "<long>",
                  "description": "A UNIX timestamp representing the most recent time a feedback was created. Defaults to 1 day prior to the time the request was issued."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "An offset for the feedback results. The endpoint returns 200 results per query."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
