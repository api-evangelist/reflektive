          "item": [
            {
              "name": "List real-time feedback (v2)",
              "id": "032c1df0-194f-4d35-b357-20f8a9b465f9",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/real-time-feedback?created_before=<long>&created_after=<long>&page=1",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "real-time-feedback"
                  ],
                  "query": [
                    {
                      "description": "A UNIX timestamp representing the oldest time a feedback was created. Defaults to the time the request was issued.",
                      "key": "created_before",
                      "value": "<long>"
                    },
                    {
                      "description": "A UNIX timestamp representing the most recent time a feedback was created. Defaults to 1 day prior to the time the request was issued.",
                      "key": "created_after",
                      "value": "<long>"
                    },
                    {
                      "description": "An offset for the feedback results. The endpoint returns 200 results per query.",
                      "key": "page",
                      "value": "1"
                    }
                  ]
                },
                "description": "Returns a paginated list of all public, positive real-time feedback records using the v2 schema. The v2 endpoint adds support for Team Recognition \u2014 feedback sent to multiple recipients simultaneously. By default 200 results are returned per query."
