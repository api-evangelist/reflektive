      "id": "c76fdf42-a55e-44b3-9c6e-6e5a2051f767",
      "name": "Real-time Feedback (v2)",
      "description": {
        "content": "V2 endpoint for real-time feedback with support for Team Recognition (multiple recipients).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "89e8424a-a7c2-41c3-ba9c-7bc96bc99a7e",
          "name": "List real-time feedback (v2)",
          "request": {
            "name": "List real-time feedback (v2)",
            "description": {
              "content": "Returns a paginated list of all public, positive real-time feedback records using the v2 schema. The v2 endpoint adds support for Team Recognition — feedback sent to multiple recipients simultaneously. By default 200 results are returned per query.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "real-time-feedback"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created_before",
                  "value": "<long>",
                  "description": "A UNIX timestamp representing the oldest time a feedback was created. Defaults to the time the request was issued."
                },
                {
                  "disabled": false,
                  "key": "created_after",
                  "value": "<long>",
                  "description": "A UNIX timestamp representing the most recent time a feedback was created. Defaults to 1 day prior to the time the request was issued."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "An offset for the feedback results. The endpoint returns 200 results per query."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
