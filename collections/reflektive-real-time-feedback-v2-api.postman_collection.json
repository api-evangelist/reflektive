  "info": {
    "_postman_id": "1aaab289-e434-494a-9570-c4d20ece2c49",
    "name": "Reflektive Real-time Feedback (v1) Real-time Feedback (v1) Real-time Feedback (v2) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Reflektive REST API provides programmatic access to performance management data including real-time feedback, performance reviews, goal management, engagement surveys, and asynchronous report generation. Authentication uses a company-level token passed as an HTTP Authorization header. The API is versioned (v1 and v2), with v2 supporting multi-recipient team recognition in addition to the core v1 resource set.\n\nContact Support:\n Email: support@reflektive.com",
      "type": "text/plain"
    }
  }
